# ─── FinanceFlow API — environment variables ────────────────────────────────
# Copy this file to .env and fill in the values:   cp .env.example .env
# Never commit .env — it is listed in .gitignore.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string.
#   Local (Docker/Postgres):  postgresql://postgres:postgres@localhost:5432/financeflow
#   Neon (pooled):            postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financeflow"

# Optional: direct (non-pooled) connection used only by Prisma migrations.
# On Neon, this is the same URL without "-pooler" in the host. Leave empty locally.
DIRECT_URL=""

# Secret used to sign JWTs — at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS — comma-separated, no trailing slash.
CLIENT_URL=http://localhost:5173

# bcrypt cost factor (12 is a good default; each +1 doubles the hashing time).
BCRYPT_ROUNDS=12

# Number of proxies in front of the API (Render/Railway: 1). Keep 0 locally.
TRUST_PROXY=0

RATE_LIMIT_ENABLED=true

# true = enable the "Try the demo" button (creates sandbox users deleted after 24h).
DEMO_MODE=true
