# Optional overrides for `npm test`. Copy to .env.test only if you need to change these;
# without it, tests use exactly these values (they match docker-compose.yml).
# Point DATABASE_URL at a SEPARATE database: the test run drops and recreates its schema.
# (The database name must contain "test"; the test setup refuses to touch anything else.)
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/financeflow_test"
JWT_SECRET="test-secret-that-is-at-least-32-characters-long"
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:5173
BCRYPT_ROUNDS=4
RATE_LIMIT_ENABLED=false
DEMO_MODE=true
