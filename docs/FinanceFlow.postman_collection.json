{
  "info": {
    "name": "FinanceFlow API",
    "description": "REST API for FinanceFlow. Run **Auth > Login** (or Register / Demo) first: it stores the JWT in the `token` collection variable, which every other request sends as a Bearer token.\n\nSet `baseUrl` to your API, e.g. `http://localhost:5000/api` or `https://<your-service>.onrender.com/api`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness probe used by Render.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates an account. 201 with { user, token }. 409 if the email is taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Verma\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"SecurePass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with a token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "200 with { user, token }. 401 'Invalid email or password' otherwise.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@financeflow.app\",\n  \"password\": \"Demo@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with a token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Start demo session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/demo",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "demo"]
            },
            "description": "Creates a sandbox user with 6 months of sample data (needs DEMO_MODE=true). Deleted after 24h.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with a token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the user the token belongs to. 401 without a valid token."
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions?page=1&limit=10&type=EXPENSE&category=FOOD&search=swiggy&startDate=2026-01-01&endDate=2026-12-31&sortBy=date&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "type",
                  "value": "EXPENSE"
                },
                {
                  "key": "category",
                  "value": "FOOD"
                },
                {
                  "key": "search",
                  "value": "swiggy"
                },
                {
                  "key": "startDate",
                  "value": "2026-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-12-31"
                },
                {
                  "key": "sortBy",
                  "value": "date"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                }
              ]
            },
            "description": "All query params are optional. Returns { data, pagination, summary }."
          }
        },
        {
          "name": "Create transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "description": "201 with { transaction, budgetAlert }. budgetAlert is set when an expense pushes the month past 80% of its budget.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 450.5,\n  \"type\": \"EXPENSE\",\n  \"category\": \"FOOD\",\n  \"description\": \"Lunch with team\",\n  \"date\": \"2026-10-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('transactionId', pm.response.json().transaction.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}"]
            },
            "description": "404 if it doesn't exist or belongs to another user."
          }
        },
        {
          "name": "Update transaction",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}"]
            },
            "description": "Full replacement; same validation as create.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"type\": \"EXPENSE\",\n  \"category\": \"FOOD\",\n  \"description\": \"Team lunch\",\n  \"date\": \"2026-10-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete transaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}"]
            },
            "description": "204 No Content."
          }
        },
        {
          "name": "Export CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/export?type=EXPENSE",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "export"],
              "query": [
                {
                  "key": "type",
                  "value": "EXPENSE"
                }
              ]
            },
            "description": "Same filters as the list endpoint, returns text/csv."
          }
        }
      ]
    },
    {
      "name": "Budget",
      "item": [
        {
          "name": "Get budget overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/budget?year=2026&month=10",
              "host": ["{{baseUrl}}"],
              "path": ["budget"],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "10"
                }
              ]
            },
            "description": "Budget, spending, status (none | on_track | warning | exceeded), category breakdown and 6-month history."
          }
        },
        {
          "name": "Set budget",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/budget",
              "host": ["{{baseUrl}}"],
              "path": ["budget"]
            },
            "description": "201. 409 if that month already has a budget.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2026,\n  \"month\": 10,\n  \"amount\": 40000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update budget",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/budget",
              "host": ["{{baseUrl}}"],
              "path": ["budget"]
            },
            "description": "200. 404 if that month has no budget yet.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2026,\n  \"month\": 10,\n  \"amount\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard?year=2026&month=10",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "10"
                }
              ]
            },
            "description": "Totals, this month, budget status, expense breakdown, 6-month trend and recent transactions."
          }
        },
        {
          "name": "Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analytics?months=6&year=2026&month=10",
              "host": ["{{baseUrl}}"],
              "path": ["analytics"],
              "query": [
                {
                  "key": "months",
                  "value": "6"
                },
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "10"
                }
              ]
            },
            "description": "months = 3, 6 or 12. Monthly series with running balance, category totals and insights."
          }
        }
      ]
    }
  ]
}
