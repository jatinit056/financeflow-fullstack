# Copy to .env.local for local overrides (never commit real values).

# Base URL of the API, including /api.
#   Local development: leave empty — Vite proxies /api to VITE_DEV_API_TARGET.
#   Production (Vercel): https://<your-render-service>.onrender.com/api
VITE_API_URL=

# Where the Vite dev server forwards /api requests (development only).
VITE_DEV_API_TARGET=http://localhost:5000
